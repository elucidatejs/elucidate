{
  "name": "elucidate-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter elucidate-starter dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "node scripts/shots.ts",
    "smoke": "node scripts/smoke.ts",
    "budgets": "node scripts/budgets.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && pnpm --filter elucidate-starter check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
