---
import config from 'virtual:elucidate/config';
import { listedTags } from '../lib/articles.ts';
import { indexPath, indexTitle, tagPath } from '../lib/paths.ts';
import ArticleList from './ArticleList.astro';

interface Props {
  /** Only list articles with this tag. */
  tag?: string | undefined;
}

const { tag } = Astro.props;
const tags = await listedTags();
const title = indexTitle();
const intro = config.home === 'index' ? config.description : '';
---

<section class="el-index">
  <div class="el-title-block el-grid">
    <h1 class="el-title">{title}</h1>
    {intro && <p class="el-index__intro">{intro}</p>}
    {
      tags.length > 0 && (
        <nav class="el-tags" aria-label="Filter by tag">
          <ul>
            <li>
              <a class="el-pill el-label" href={indexPath()} aria-current={tag ? undefined : 'page'}>
                All
              </a>
            </li>
            {tags.map((t) => (
              <li>
                <a class="el-pill el-label" href={tagPath(t)} aria-current={t === tag ? 'page' : undefined}>
                  {t}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
  <div class="el-grid">
    <ArticleList tag={tag} />
  </div>
</section>
