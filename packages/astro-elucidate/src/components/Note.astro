---
import '../styles/blocks.css';

export interface Props {
  /** A short label above the note, such as "Caveat". */
  label?: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['el-note', className]} role="note">
  {label && <p class="el-note__label el-label">{label}</p>}
  <slot />
</div>
