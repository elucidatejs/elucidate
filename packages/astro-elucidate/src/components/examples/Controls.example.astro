<div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: center">
  <label style="display: grid; gap: 4px; font-size: var(--el-text-small)">
    Momentum β
    <input class="el-slider" type="range" min="0" max="0.99" step="0.01" value="0.9" />
  </label>
  <div class="el-segmented" role="radiogroup" aria-label="Step size">
    <label><input type="radio" name="showcase-step" value="0.01" checked /><span>0.01</span></label>
    <label><input type="radio" name="showcase-step" value="0.1" /><span>0.1</span></label>
    <label><input type="radio" name="showcase-step" value="1" /><span>1</span></label>
  </div>
  <label class="el-toggle"><input type="checkbox" role="switch" checked /> Show the path</label>
</div>
