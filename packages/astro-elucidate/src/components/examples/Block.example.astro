---
import Block from '../Block.astro';
---

<Block width="page">
  <div style="display: grid; grid-template-columns: repeat(8, 1fr); gap: 2px; height: 48px">
    <div style="background: var(--el-data-1)"></div>
    <div style="background: var(--el-data-2)"></div>
    <div style="background: var(--el-data-3)"></div>
    <div style="background: var(--el-data-4)"></div>
    <div style="background: var(--el-data-5)"></div>
    <div style="background: var(--el-data-6)"></div>
    <div style="background: var(--el-data-7)"></div>
    <div style="background: var(--el-data-8)"></div>
  </div>
</Block>
