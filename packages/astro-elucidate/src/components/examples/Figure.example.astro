---
import Figure from '../Figure.astro';
---

<Figure
  caption="Three series in the first three palette colors."
  description="Three rows of dots. The first rises from left to right, the second stays level and the third falls."
>
  <svg viewBox="0 0 320 120" role="img" aria-label="Three series of dots">
    <g fill="var(--el-data-1)"><circle cx="40" cy="90" r="5" /><circle cx="160" cy="60" r="5" /><circle cx="280" cy="30" r="5" /></g>
    <g fill="var(--el-data-2)"><circle cx="40" cy="60" r="5" /><circle cx="160" cy="60" r="5" /><circle cx="280" cy="60" r="5" /></g>
    <g fill="var(--el-data-3)"><circle cx="40" cy="30" r="5" /><circle cx="160" cy="60" r="5" /><circle cx="280" cy="90" r="5" /></g>
  </svg>
</Figure>
