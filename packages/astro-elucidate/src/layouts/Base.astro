---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/chrome.css';
import '../styles/components.css';
import '../styles/controls.css';
import 'virtual:elucidate/user-styles';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';

export interface Props {
  title: string;
  description?: string | undefined;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  image?: string | undefined;
  /** Whether to show the site header and footer (a bespoke article may leave them out). */
  header?: boolean;
  footer?: boolean;
}

const { header = true, footer = true, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...head}><slot name="head" /></Head>
  </head>
  <body>
    <a class="el-skip" href="#main">Skip to content</a>
    {header && <Header />}
    <main id="main"><slot /></main>
    {footer && <Footer />}
  </body>
</html>
