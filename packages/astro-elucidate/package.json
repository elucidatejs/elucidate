    "@citation-js/plugin-bibtex": "^0.9.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-html": "^9.0.6",
    "katex": "^0.19.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3"
