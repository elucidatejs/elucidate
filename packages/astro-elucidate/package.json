{
  "name": "astro-elucidate",
  "version": "0.0.0",
  "description": "Web-native scientific articles for Astro, in the spirit of Distill.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elucidatejs/elucidate.git",
    "directory": "packages/astro-elucidate"
  },
  "homepage": "https://github.com/elucidatejs/elucidate#readme",
  "keywords": [
    "astro-integration",
    "withastro",
    "mdx",
    "science",
    "scholarly",
    "distill"
  ],
  "bin": {
    "elucidate": "bin/elucidate.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./content": "./src/content.ts",
    "./layouts": "./src/layouts/index.ts",
    "./layouts/*": "./src/layouts/*",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./client": "./src/client/index.ts",
    "./palette": "./src/palette.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "typecheck": "astro check"
  },
  "peerDependencies": {
    "@mathjax/src": "^4.1.0",
    "astro": "^7.4.0"
  },
  "peerDependenciesMeta": {
    "@mathjax/src": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@mathjax/src": "^4.1.3",
    "astro": "^7.4.10",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.7",
